# Supabase project that holds the website_enquiries table (suryavastra-staging).
NEXT_PUBLIC_SUPABASE_URL=https://tyustemnubltqpvcfklm.supabase.co
# Publishable (anon) key. Safe to deploy: RLS lets it insert an enquiry and nothing else.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# The live address, used for canonical URLs, the sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://suryavastrasolarenergy.com
# Read at BUILD time. Anything other than exactly "true" makes robots.txt
# disallow everything, so the site stays out of Google. Set it to true in the
# host's environment and redeploy on the day the real domain goes live —
# changing it without a fresh build has no effect at all.
SITE_LIVE=false
